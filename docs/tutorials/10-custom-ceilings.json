{
  "tutorial": "Custom Ceilings",
  "source": "Chief Architect X18 Tutorial Guide, Interior Design Tutorials, pages 177-190",
  "include": "08-chic-cottage-roof.json",
  "steps": [
    {
      "step": "Ceiling finish defaults: drywall and paint; the Garage room type gets 5/8\" fire-rated drywall under 1 1/2\" rigid insulation",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "ceiling_finish": [
              {
                "name": "Drywall",
                "thickness": "1/2\""
              },
              {
                "name": "Paint",
                "thickness": "1/32\""
              }
            ]
          }
        },
        {
          "op": "update",
          "id": "$named:room_type:Garage",
          "set": {
            "ceiling_finish": [
              {
                "name": "Rigid insulation",
                "thickness": "1 1/2\""
              },
              {
                "name": "Fire-rated drywall",
                "thickness": "5/8\""
              }
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$named:room_type:Garage",
          "path": "/ceiling_finish/1/thickness",
          "is": "5/8\""
        }
      ]
    },
    {
      "step": "Hat channel: a steel framing type for the ceiling joists",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "framing": {
              "ceiling_joist_material": "hat_channel"
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/framing/ceiling_joist_material",
          "is": "hat_channel"
        }
      ]
    },
    {
      "step": "A 'Hat Channel' material (grey, not in the materials list), added to the library",
      "commands": [
        {
          "op": "add_material",
          "name": "Hat Channel",
          "color": "#808080"
        }
      ],
      "expect": [
        {
          "get": "$named:material:Hat Channel",
          "path": "/name",
          "is": "Hat Channel"
        }
      ]
    },
    {
      "step": "Lowered basement ceiling: Floor 0's ceiling finish gets a 1\" hat channel layer",
      "commands": [
        {
          "op": "update",
          "id": "$room_at:6350.0,-3810.0@Foundation",
          "set": {
            "ceiling_height": "112 1/8\""
          }
        }
      ],
      "expect": [
        {
          "get": "$room_at:6350.0,-3810.0@Foundation",
          "path": "/ceiling_height",
          "is": "112 1/8\""
        }
      ]
    },
    {
      "step": "Through the ceiling finish: a 1\" hat channel layer above the drywall lowers the basement ceiling",
      "commands": [
        {
          "op": "update",
          "id": "$room_at:6350.0,-3810.0@Foundation",
          "set": {
            "ceiling_finish": [
              {
                "name": "Hat Channel",
                "thickness": "1\""
              },
              {
                "name": "Drywall",
                "thickness": "1/2\""
              },
              {
                "name": "Paint",
                "thickness": "1/32\""
              }
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$room_at:6350.0,-3810.0@Foundation",
          "path": "/ceiling_finish/0/name",
          "is": "Hat Channel"
        }
      ]
    },
    {
      "step": "Remove the ceiling finish from the Porch (the basement doesn't reach under it here)",
      "commands": [
        {
          "op": "update",
          "id": "$room_at:6350.0,-9652.0",
          "set": {
            "ceiling_finish": []
          }
        }
      ],
      "expect": [
        {
          "get": "$room_at:6350.0,-9652.0",
          "path": "/ceiling_finish",
          "len_at_least": 0
        }
      ]
    },
    {
      "step": "Cathedral ceiling over the Deck: the ceiling follows the roof (Vaulted)",
      "commands": [
        {
          "op": "update",
          "id": "$deck",
          "set": {
            "vaulted": true
          }
        }
      ],
      "expect": [
        {
          "get": "$deck",
          "path": "/vaulted",
          "is": true
        }
      ]
    },
    {
      "step": "Tray ceiling in the basement with 36\" x 12\" soffits round the room",
      "commands": [
        {
          "op": "update",
          "id": "$room_at:6350.0,-3810.0@Foundation",
          "set": {
            "ceiling": {
              "style": "tray",
              "inset": "36\"",
              "rise": "12\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$room_at:6350.0,-3810.0@Foundation",
          "path": "/ceiling/style",
          "is": "tray"
        }
      ]
    },
    {
      "step": "(Soffit tool and its defaults; soffits stopped either side of the stair wall)",
      "gap": "No Soffit tool; use the room's Ceiling: Tray (or Coffered). Row: CB-26"
    },
    {
      "step": "Coffered ceiling: more soffits across the room (Copy/Paste, Reflect About Object)",
      "commands": [
        {
          "op": "update",
          "id": "$room_at:6350.0,-3810.0@Foundation",
          "set": {
            "ceiling": {
              "style": "coffered",
              "spacing": "6'",
              "beam_width": "36\"",
              "depth": "12\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$room_at:6350.0,-3810.0@Foundation",
          "path": "/ceiling/style",
          "is": "coffered"
        }
      ]
    },
    {
      "step": "Annotations: '36\" X 12\" SOFFITS' in the basement, '2:12 CATHEDRAL CEILING' on the deck",
      "commands": [
        {
          "op": "add_text",
          "floor": "$named:floor:Foundation",
          "position": [
            6350.0,
            -1016.0
          ],
          "text": "36\" X 12\" SOFFITS"
        },
        {
          "op": "add_text",
          "floor": "$floor1",
          "position": [
            6350.0,
            1270.0
          ],
          "text": "2:12 CATHEDRAL CEILING"
        }
      ],
      "expect": [
        {
          "text_exists": "2:12 CATHEDRAL CEILING"
        }
      ]
    },
    {
      "step": "Save a copy as Chic Cottage-Ceilings"
    }
  ]
}
