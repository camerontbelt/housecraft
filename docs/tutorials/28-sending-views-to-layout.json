{
  "tutorial": "Sending Views to Layout",
  "source": "Chief Architect X18 Tutorial Guide, Layout Tutorials, pages 483-500",
  "include": "27-title-blocks-and-borders.json",
  "steps": [
    {
      "step": "Default drawing scale for plan views: 1/4 in = 1 ft",
      "commands": [
        {
          "op": "set_layout_scale",
          "scale": 48.0
        }
      ]
    },
    {
      "step": "Send the dimensioned Floor 1 plan to page 6 (A1.3 Floor 1 Plan) at 1/4\" = 1'",
      "commands": [
        {
          "op": "send_to_layout",
          "layout": "$lay",
          "page": 6,
          "source": {
            "type": "plan",
            "floor": "$floor1"
          },
          "scale": 48.0
        }
      ],
      "save": {
        "fp": "layout_box"
      },
      "expect": [
        {
          "get": "$fp",
          "path": "/page",
          "is": 6
        },
        {
          "get": "$fp",
          "path": "/scale",
          "is": 48.0
        }
      ]
    },
    {
      "step": "Send the Electrical Plan View to page 9 (E1.1)",
      "commands": [
        {
          "op": "send_to_layout",
          "layout": "$lay",
          "page": 9,
          "source": {
            "type": "plan",
            "floor": "$floor1",
            "layer_set": "$named:layer_set:Electrical Plan"
          },
          "scale": 48.0
        }
      ],
      "save": {
        "ep": "layout_box"
      }
    },
    {
      "step": "Link Saved Plan View: the box follows the Electrical Plan view (its layer set and defaults)",
      "commands": [
        {
          "op": "update",
          "id": "$ep",
          "set": {
            "source": {
              "plan_view": "$named:plan_view:Electrical Plan"
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$ep",
          "path": "/source/plan_view",
          "is": "$named:plan_view:Electrical Plan"
        }
      ]
    },
    {
      "step": "Send the Plot Plan View to page 4 (A1.1 Site Plan) at 1\" = 100'",
      "commands": [
        {
          "op": "send_to_layout",
          "layout": "$lay",
          "page": 4,
          "source": {
            "type": "plan",
            "floor": "$floor1"
          },
          "scale": 1200.0
        }
      ],
      "save": {
        "site": "layout_box"
      },
      "expect": [
        {
          "get": "$site",
          "path": "/scale",
          "is": 1200.0
        }
      ]
    },
    {
      "step": "Rotate the site plan 90 degrees, crop it, centre it in the border, move its label",
      "commands": [
        {
          "op": "update",
          "id": "$site",
          "set": {
            "width": "20\"",
            "height": "18\"",
            "x": "4\"",
            "y": "3\""
          }
        }
      ],
      "expect": [
        {
          "get": "$site",
          "path": "/width",
          "is": "20\""
        }
      ]
    },
    {
      "step": "Rotate the site plan 90 degrees, Center Object on the border, move its label",
      "commands": [
        {
          "op": "update",
          "id": "$site",
          "set": {
            "rotation": 90.0,
            "caption_offset": [
              "2\"",
              "0\""
            ]
          }
        },
        {
          "op": "center_layout_box",
          "id": "$site"
        }
      ],
      "expect": [
        {
          "get": "$site",
          "path": "/rotation",
          "is": 90.0
        },
        {
          "get": "$site",
          "path": "/caption_offset/0",
          "is": "2\""
        }
      ]
    },
    {
      "step": "Send the saved Stair Section to page 8 (A2.2 Sections) at 1/2\" = 1'",
      "commands": [
        {
          "op": "send_to_layout",
          "layout": "$lay",
          "page": 8,
          "source": {
            "type": "view",
            "view": "$named:section_view:Stair Section"
          },
          "scale": 24.0
        }
      ],
      "save": {
        "ss": "layout_box"
      },
      "expect": [
        {
          "get": "$ss",
          "path": "/scale",
          "is": 24.0
        }
      ]
    },
    {
      "step": "Back Clipped elevation of the right side, saved as 'Exterior Elevation - Right', sent to page 7 (A2.1) as plot lines with colour fill at 1/4\" = 1'",
      "commands": [
        {
          "op": "add_section_view",
          "floor": "$floor1",
          "name": "Exterior Elevation - Right",
          "a": [
            21336.0,
            -6096.0
          ],
          "b": [
            9144.0,
            -6096.0
          ],
          "section_kind": "elevation"
        }
      ],
      "save": {
        "rel": "section_view"
      }
    },
    {
      "step": "(send it)",
      "commands": [
        {
          "op": "send_to_layout",
          "layout": "$lay",
          "page": 7,
          "source": {
            "type": "view",
            "view": "$rel"
          },
          "scale": 48.0
        }
      ],
      "save": {
        "elbox": "layout_box"
      },
      "expect": [
        {
          "get": "$elbox",
          "path": "/page",
          "is": 7
        }
      ]
    },
    {
      "step": "(Plot Lines vs Live View; colour fill: elevation boxes are live and colour-filled; Lines Only drops the fill)",
      "commands": [
        {
          "op": "update",
          "id": "$elbox",
          "set": {
            "lines_only": true
          }
        },
        {
          "op": "update",
          "id": "$elbox",
          "set": {
            "lines_only": false
          }
        }
      ],
      "expect": [
        {
          "get": "$elbox",
          "path": "/source/type",
          "is": "view"
        }
      ]
    },
    {
      "step": "Crop and move the elevation into a corner",
      "commands": [
        {
          "op": "update",
          "id": "$elbox",
          "set": {
            "width": "16\"",
            "height": "8\"",
            "x": "1\"",
            "y": "14\""
          }
        }
      ],
      "expect": [
        {
          "get": "$elbox",
          "path": "/height",
          "is": "8\""
        }
      ]
    },
    {
      "step": "Callout label on the Stair Section box: S1, view name above, scale below, linked to page A1.3, one large filled arrow",
      "commands": [
        {
          "op": "update",
          "id": "$ss",
          "set": {
            "label": "S1 STAIR SECTION  1/2\" = 1'-0\"  (A1.3)"
          }
        }
      ],
      "expect": [
        {
          "get": "$ss",
          "path": "/label",
          "is": "S1 STAIR SECTION  1/2\" = 1'-0\"  (A1.3)"
        }
      ]
    },
    {
      "step": "Callout-style label with macros: S{number}, the view's name and scale, linked to page A1.3",
      "commands": [
        {
          "op": "update",
          "id": "$ss",
          "set": {
            "label": "S{number} {view}  {scale}  ({link_sheet})",
            "link_page": 6
          }
        }
      ],
      "expect": [
        {
          "get": "$ss",
          "path": "/link_page",
          "is": 6
        }
      ]
    },
    {
      "step": "Full Camera 'Cover Sheet View', saved as a picture and placed on page 2 (Cover Sheet); resize and crop it",
      "commands": [
        {
          "op": "send_to_layout",
          "layout": "$lay",
          "page": 2,
          "source": {
            "type": "picture",
            "path": "samples/cover-sheet-view.png"
          },
          "x": "6\"",
          "y": "6\"",
          "width": "18\"",
          "height": "12\"",
          "label": ""
        }
      ],
      "save": {
        "cover3d": "layout_box"
      },
      "expect": [
        {
          "get": "$cover3d",
          "path": "/source/type",
          "is": "picture"
        }
      ]
    },
    {
      "step": "Print the layout to PDF (ARCH D, 24\" x 36\") — Done with File > Layout > Export Layout as PDF while the layout is open; not part of the scripted test."
    }
  ]
}
