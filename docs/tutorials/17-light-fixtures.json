{
  "tutorial": "Light Fixtures",
  "source": "Chief Architect X18 Tutorial Guide, Kitchen and Bath Tutorials, pages 298-316",
  "include": "16-appliances-and-fixtures.json",
  "steps": [
    {
      "step": "Electrical defaults: recessed can for ceiling lights, a sconce for wall lights",
      "gap": "Each light tool places its own fixture; no Electrical Defaults choosing the style a tool places. Set the style on each light. Row: EL-11"
    },
    {
      "step": "Switch to the Electrical Plan View",
      "commands": [
        {
          "op": "add_standard_plan_views"
        }
      ],
      "expect": [
        {
          "get": "$named:plan_view:Electrical Plan",
          "path": "/name",
          "is": "Electrical Plan"
        }
      ]
    },
    {
      "step": "Light tool: a recessed can light in the Kitchen between the island and the dishwasher",
      "commands": [
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "recessed_light",
          "at": [
            1270.0,
            -3810.0
          ]
        }
      ],
      "save": {
        "can": "electrical"
      },
      "expect": [
        {
          "get": "$can",
          "path": "/electrical_kind",
          "is": "recessed_light"
        }
      ]
    },
    {
      "step": "(One Light tool that places a sconce on a wall, a ceiling light in a room, a path light outside)",
      "gap": "Separate tools for ceiling, recessed and wall lights; no context-sensitive Light tool or path lights. Row: EL-12"
    },
    {
      "step": "Library lights: a bowl chandelier in the Dining room, a half-dome flush mount and an eyeball recessed light in the Foyer, a caged lantern pendant on the Deck",
      "commands": [
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "ceiling_light",
          "at": [
            2032.0,
            -7112.0
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "ceiling_light",
          "at": [
            6096.0,
            -7874.0
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "recessed_light",
          "at": [
            6096.0,
            -5842.0
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "ceiling_light",
          "at": [
            6350.0,
            1219.2
          ]
        }
      ],
      "save": {
        "lib": "electrical"
      },
      "expect": [
        {
          "count": "electrical",
          "is": 5
        }
      ]
    },
    {
      "step": "(Open each library light: Fixture Chandelier in the Dining room, Flush Mount in the Foyer, Lantern on the Deck)",
      "commands": [
        {
          "op": "update",
          "id": "$lib.0",
          "set": {
            "fixture": {
              "style": "chandelier",
              "width": "26\"",
              "drop": "30\""
            }
          }
        },
        {
          "op": "update",
          "id": "$lib.1",
          "set": {
            "fixture": {
              "style": "flush_mount",
              "width": "14\"",
              "drop": "4\""
            }
          }
        },
        {
          "op": "update",
          "id": "$lib.3",
          "set": {
            "fixture": {
              "style": "lantern",
              "width": "10\"",
              "drop": "18\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$lib.0",
          "path": "/fixture/style",
          "is": "chandelier"
        },
        {
          "get": "$lib.3",
          "path": "/fixture/style",
          "is": "lantern"
        },
        {
          "built": "$lib.0"
        }
      ]
    },
    {
      "step": "Dimension defaults: Locate Manual for cabinet sides, fixture corners, electrical and blocks",
      "gap": "Manual dimensions snap to any object edge; there are no per-category locate settings. Row: DIM-29"
    },
    {
      "step": "Position the can light 21\" from the refrigerator and 21\" from the dishwasher by typing on dimension lines",
      "commands": [
        {
          "op": "update",
          "id": "$can",
          "set": {
            "position": [
              1295.4,
              -3810.0
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$can",
          "path": "/position/0",
          "is": 1295.4
        }
      ]
    },
    {
      "step": "(A dimension from the Kitchen's left wall to the can light; select the light, click the number and type 21\")",
      "commands": [
        {
          "op": "add_dimension",
          "floor": "$floor1",
          "geometry": {
            "type": "linear",
            "points": [
              [
                61.119,
                -3810.0
              ],
              [
                1295.4,
                -3810.0
              ]
            ],
            "orientation": "horizontal",
            "offset": "1'"
          }
        }
      ],
      "save": {
        "candim": "dimension"
      }
    },
    {
      "step": "(type it)",
      "commands": [
        {
          "op": "move_by_dimension",
          "dimension": "$candim",
          "segment": 0,
          "moving": 1,
          "ids": [
            "$can"
          ],
          "length": "21\""
        }
      ],
      "expect": [
        {
          "get": "$can",
          "path": "/position/0",
          "is": 594.519
        }
      ]
    },
    {
      "step": "(Add an extension line to the dimension: select it, Edit > Add Extension Line, click the Kitchen's right wall)",
      "commands": [
        {
          "op": "add_dimension_point",
          "id": "$candim",
          "at": [
            4089.4,
            -3810.0
          ]
        }
      ],
      "expect": [
        {
          "get": "$candim",
          "path": "/geometry/points/2/0",
          "is": 4089.4
        }
      ]
    },
    {
      "step": "Copy/Paste the can light 40\" up (Tab for Enter Coordinates)",
      "commands": [
        {
          "op": "transform",
          "ids": [
            "$can"
          ],
          "transform": {
            "type": "translate",
            "dx": 0,
            "dy": "40\""
          },
          "copies": 1
        }
      ],
      "save": {
        "can2": "electrical"
      },
      "expect": [
        {
          "count": "electrical",
          "is": 6
        }
      ]
    },
    {
      "step": "Reflect both lights about the island",
      "commands": [
        {
          "op": "transform",
          "ids": [
            "$can",
            "$can2"
          ],
          "transform": {
            "type": "mirror",
            "a": [
              2032.0,
              0.0
            ],
            "b": [
              2032.0,
              -5080.0
            ]
          },
          "copies": 1
        }
      ],
      "save": {
        "refl": "electrical"
      },
      "expect": [
        {
          "count": "electrical",
          "is": 8
        }
      ]
    },
    {
      "step": "Transform/Replicate: copy all four 6'6\" to the right; then copy the top and bottom ones back 3'3\"",
      "commands": [
        {
          "op": "transform",
          "ids": [
            "$can",
            "$can2",
            "$refl.0",
            "$refl.1"
          ],
          "transform": {
            "type": "translate",
            "dx": "6'6\"",
            "dy": 0
          },
          "copies": 1
        }
      ],
      "save": {
        "rep": "electrical"
      },
      "expect": [
        {
          "count": "electrical",
          "is": 12
        }
      ]
    },
    {
      "step": "(second replicate)",
      "commands": [
        {
          "op": "transform",
          "ids": [
            "$rep.0",
            "$rep.1"
          ],
          "transform": {
            "type": "translate",
            "dx": "-3'3\"",
            "dy": 0
          },
          "copies": 1
        }
      ],
      "expect": [
        {
          "count": "electrical",
          "is": 14
        }
      ]
    },
    {
      "step": "Basement: a can light 5' from the two nearest walls",
      "commands": [
        {
          "op": "add_electrical",
          "floor": "$named:floor:Foundation",
          "electrical_kind": "recessed_light",
          "at": [
            1788.319,
            -6858.0
          ]
        }
      ],
      "save": {
        "bcan": "electrical"
      }
    },
    {
      "step": "Multiple Copy with interval 50\" x 52\": a column of lights, then across the basement",
      "commands": [
        {
          "op": "transform",
          "ids": [
            "$bcan"
          ],
          "transform": {
            "type": "translate",
            "dx": 0,
            "dy": "50\""
          },
          "copies": 4
        }
      ],
      "save": {
        "col": "electrical"
      },
      "expect": [
        {
          "count": "electrical",
          "is": 19
        }
      ]
    },
    {
      "step": "(and across)",
      "commands": [
        {
          "op": "transform",
          "ids": [
            "$bcan",
            "$col.0",
            "$col.1",
            "$col.2",
            "$col.3"
          ],
          "transform": {
            "type": "translate",
            "dx": "52\"",
            "dy": 0
          },
          "copies": 4
        }
      ],
      "expect": [
        {
          "count": "electrical",
          "is": 39
        }
      ]
    },
    {
      "step": "(Multiple Copy Interval with a 2D right-drag array)",
      "gap": "Multiple Copy makes a row; make an array by copying the row. No interval dialog or right-drag 2D array. Row: CAD-08"
    },
    {
      "step": "Wall lights: a sconce over the Kitchen sink; one on the outside wall at the Deck; two Prism sconces either side of the Bath vanity",
      "commands": [
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "wall_light",
          "at": [
            86.519,
            -3251.2
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "wall_light",
          "at": [
            7620.0,
            50.8
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "wall_light",
          "at": [
            11068.05,
            -3759.2
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "wall_light",
          "at": [
            11068.05,
            -4368.8
          ]
        }
      ],
      "save": {
        "wall": "electrical"
      },
      "expect": [
        {
          "count": "electrical",
          "is": 43
        },
        {
          "get": "$wall.1",
          "path": "/rotation",
          "is": 90.0
        },
        {
          "get": "$wall.0",
          "path": "/rotation",
          "is": 0.0
        }
      ]
    },
    {
      "step": "Wall Elevation: the sconce 12\" wide, centre 86\" off the floor, centred over the left window; copies over the other two windows",
      "commands": [
        {
          "op": "update",
          "id": "$wall.0",
          "set": {
            "height": "86\""
          }
        },
        {
          "op": "transform",
          "ids": [
            "$wall.0"
          ],
          "transform": {
            "type": "translate",
            "dx": 0,
            "dy": "36\""
          },
          "copies": 2
        }
      ],
      "expect": [
        {
          "get": "$wall.0",
          "path": "/height",
          "is": "86\""
        },
        {
          "count": "electrical",
          "is": 45
        }
      ]
    },
    {
      "step": "(Light fixture width: open the chandelier and set Fixture Width 30\")",
      "commands": [
        {
          "op": "update",
          "id": "$lib.0",
          "set": {
            "fixture": {
              "style": "chandelier",
              "width": "30\"",
              "drop": "30\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$lib.0",
          "path": "/fixture/width",
          "is": "30\""
        }
      ]
    },
    {
      "step": "Table lamps either side of the bed in the Bedroom; a floor lamp in the Living room (ceiling lights given a lamp Fixture)",
      "commands": [
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "ceiling_light",
          "at": [
            9900.0,
            -1524.0
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "ceiling_light",
          "at": [
            10900.0,
            -1524.0
          ]
        },
        {
          "op": "add_electrical",
          "floor": "$floor1",
          "electrical_kind": "ceiling_light",
          "at": [
            5300.0,
            -1800.0
          ]
        }
      ],
      "save": {
        "lamps": "electrical"
      },
      "expect": [
        {
          "get": "$room_at:9900.0,-1524.0",
          "path": "/room_type",
          "is": "$named:room_type:Bedroom"
        },
        {
          "get": "$room_at:5300.0,-1800.0",
          "path": "/room_type",
          "is": "$named:room_type:Living"
        }
      ]
    },
    {
      "step": "(Open each: Fixture Table Lamp, Height 26\" for the end tables; Fixture Floor Lamp)",
      "commands": [
        {
          "op": "update",
          "id": "$lamps.0",
          "set": {
            "fixture": {
              "style": "table_lamp",
              "width": "16\"",
              "drop": "26\""
            },
            "height": "26\""
          }
        },
        {
          "op": "update",
          "id": "$lamps.1",
          "set": {
            "fixture": {
              "style": "table_lamp",
              "width": "16\"",
              "drop": "26\""
            },
            "height": "26\""
          }
        },
        {
          "op": "update",
          "id": "$lamps.2",
          "set": {
            "fixture": {
              "style": "floor_lamp",
              "width": "18\"",
              "drop": "60\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$lamps.2",
          "path": "/fixture/style",
          "is": "floor_lamp"
        },
        {
          "built": "$lamps.0"
        }
      ]
    },
    {
      "step": "Kitchen lighting schedule (Create Schedule from Room, lighting only, titled)",
      "commands": [
        {
          "op": "add_schedule",
          "floor": "$floor1",
          "schedule_kind": "fixtures",
          "position": [
            -5080.0,
            0.0
          ]
        }
      ],
      "save": {
        "sched": "schedule"
      },
      "expect": [
        {
          "get": "$sched",
          "path": "/schedule_kind",
          "is": "fixtures"
        }
      ]
    },
    {
      "step": "Schedule from the Kitchen: only lighting, titled Kitchen Lighting",
      "commands": [
        {
          "op": "update",
          "id": "$sched",
          "set": {
            "room": "$room_at:2032.0,-2540.0",
            "filter": "light",
            "title": "Kitchen Lighting"
          }
        }
      ],
      "expect": [
        {
          "get": "$sched",
          "path": "/title",
          "is": "Kitchen Lighting"
        }
      ]
    },
    {
      "step": "Electrical rich text defaults: uppercase",
      "commands": [
        {
          "op": "add_text_style",
          "name": "Electrical Notes",
          "height": "6\""
        }
      ],
      "save": {
        "caps": "text_style"
      }
    },
    {
      "step": "(capitals)",
      "commands": [
        {
          "op": "update",
          "id": "$caps",
          "set": {
            "uppercase": true
          }
        }
      ],
      "expect": [
        {
          "get": "$caps",
          "path": "/uppercase",
          "is": true
        }
      ]
    },
    {
      "step": "Leader to the Deck light with the %description% macro",
      "commands": [
        {
          "op": "add_text",
          "floor": "$floor1",
          "position": [
            5588.0,
            1524.0
          ],
          "text": "CEILING LIGHT",
          "leaders": [
            [
              6350.0,
              1219.2
            ]
          ]
        }
      ],
      "expect": [
        {
          "text_exists": "CEILING LIGHT"
        }
      ]
    },
    {
      "step": "The macro reads the light it points at",
      "commands": [
        {
          "op": "add_text",
          "floor": "$floor1",
          "position": [
            5588.0,
            2000.0
          ],
          "text": "{ref_name}",
          "leaders": [
            [
              6350.0,
              1219.2
            ]
          ]
        }
      ],
      "save": {
        "lightref": "text"
      }
    },
    {
      "step": "(what it reads)",
      "expect": [
        {
          "text_reads": "$lightref",
          "is": "Lantern"
        }
      ]
    },
    {
      "step": "File > Make a Copy as Chic Cottage-Lighting"
    }
  ]
}
