{
  "tutorial": "Driveways, Sidewalks, and Roads",
  "source": "Chief Architect X18 Tutorial Guide, Landscaping Tutorials, pages 420-432",
  "include": "23-terrain-elevation.json",
  "steps": [
    {
      "step": "Road defaults: 28' wide; curbs that can cut driveways and sidewalks",
      "gap": "No road, driveway or sidewalk defaults: a new road is 24' wide; set the width on each. No curb cuts. Row: SITE-32"
    },
    {
      "step": "Straight Road across the bottom of the terrain, corner to corner",
      "commands": [
        {
          "op": "add_site_feature",
          "floor": "$floor1",
          "points": [
            [
              40538.4,
              3048.0
            ],
            [
              4572.0,
              -27127.2
            ]
          ],
          "feature": {
            "type": "road",
            "style": "road",
            "width": "28'",
            "thickness": "6\"",
            "curbs": true
          }
        }
      ],
      "save": {
        "road": "site_feature"
      },
      "expect": [
        {
          "get": "$road",
          "path": "/feature/width",
          "is": "28'"
        }
      ]
    },
    {
      "step": "(Change Line/Arc to curve it along the lot's curved edge; Point to Point Move onto the edge)",
      "gap": "Roads are straight-segment paths; no arcs. Row: SITE-32"
    },
    {
      "step": "Road Stripe for a bike lane, 6' from the road's edge (both sides)",
      "commands": [
        {
          "op": "update",
          "id": "$road",
          "set": {
            "feature": {
              "stripes": [
                "8'",
                "-8'"
              ]
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$road",
          "path": "/feature/stripes/1",
          "is": "-8'"
        }
      ]
    },
    {
      "step": "Pull the terrain edge out to the road's far edge so the road shows in 3D (copy of the perimeter kept as a plot plan polyline)",
      "commands": [
        {
          "op": "add_elevation_data",
          "floor": "$floor1",
          "shape": {
            "type": "line",
            "points": [
              [
                42672.0,
                609.6
              ],
              [
                3048.0,
                -29260.8
              ]
            ],
            "elevation": "-8'"
          }
        }
      ],
      "expect": [
        {
          "count": "site_feature",
          "is": 2
        }
      ]
    },
    {
      "step": "(Roads follow the terrain along their centre line; an elevation line down the road's middle evens the slope)",
      "expect": [
        {
          "ground_at": [
            22860.0,
            -14325.6
          ],
          "is": "-8'",
          "within": "2'"
        }
      ]
    },
    {
      "step": "Driveway defaults: 13' wide, end flared 3', Blacktop 1",
      "gap": "No driveway defaults; the width, end flare and material are set on the driveway (below). Row: SITE-32"
    },
    {
      "step": "Straight Driveway from the middle of the Garage door straight down to the road, its end flared 3'",
      "commands": [
        {
          "op": "add_site_feature",
          "floor": "$floor1",
          "points": [
            [
              10820.4,
              -11734.8
            ],
            [
              10820.4,
              -21336.0
            ]
          ],
          "feature": {
            "type": "road",
            "style": "driveway",
            "width": "13'",
            "thickness": "4\"",
            "curbs": false,
            "flare": "3'"
          }
        }
      ],
      "save": {
        "drive": "site_feature"
      },
      "expect": [
        {
          "get": "$drive",
          "path": "/feature/style",
          "is": "driveway"
        },
        {
          "get": "$drive",
          "path": "/feature/flare",
          "is": "3'"
        }
      ]
    },
    {
      "step": "Auto Generate Sidewalks: 5' wide, 60\" from the road",
      "commands": [
        {
          "op": "auto_sidewalks",
          "road": "$road",
          "width": "5'",
          "gap": "60\""
        }
      ],
      "save": {
        "walks": "site_feature"
      },
      "expect": [
        {
          "count": "site_feature",
          "is": 5
        },
        {
          "get": "$walks.1",
          "path": "/feature/width",
          "is": "5'"
        }
      ]
    },
    {
      "step": "Straight Sidewalk down from the porch stairs, then a second segment over to the driveway",
      "commands": [
        {
          "op": "add_site_feature",
          "floor": "$floor1",
          "points": [
            [
              6096.0,
              -11277.6
            ],
            [
              6096.0,
              -15240.0
            ],
            [
              8839.2,
              -15240.0
            ]
          ],
          "feature": {
            "type": "road",
            "style": "sidewalk",
            "width": "5'",
            "thickness": "4\"",
            "curbs": false
          }
        }
      ],
      "save": {
        "walk": "site_feature"
      },
      "expect": [
        {
          "get": "$walk",
          "path": "/points/2/0",
          "is": "29'"
        }
      ]
    },
    {
      "step": "Curved sidewalk instead: one segment at 315 degrees, made into an arc",
      "gap": "No curved sidewalks; add more corners to round it off. Row: SITE-32"
    },
    {
      "step": "Annotations: street name label on the road",
      "commands": [
        {
          "op": "update",
          "id": "$road",
          "set": {
            "feature": {
              "label": "Garden Way"
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$road",
          "path": "/feature/label",
          "is": "Garden Way"
        }
      ]
    },
    {
      "step": "(A hardscaping schedule)",
      "gap": "No hardscaping schedule. Row: SITE-32"
    },
    {
      "step": "Make a Copy as Chic Cottage-Hardscape"
    }
  ]
}
