{
  "tutorial": "Floor Framing",
  "source": "Chief Architect X18 Tutorial Guide, Framing Tutorials, pages 331-348",
  "include": "18-electrical-objects.json",
  "steps": [
    {
      "step": "Framing Type defaults: I-joists for the floor joists (lumber and LVL are built in)",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "framing": {
              "floor_joist_material": "i_joist"
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/framing/floor_joist_material",
          "is": "i_joist"
        }
      ]
    },
    {
      "step": "Switch to the Framing, Floor Plan View",
      "expect": [
        {
          "get": "$named:plan_view:Framing Plan",
          "path": "/name",
          "is": "Framing Plan"
        }
      ]
    },
    {
      "step": "Automatic framing defaults: floor joists 16\" OC, 1 1/2\" wide",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "framing": {
              "joist_spacing": "16\"",
              "lumber_width": "1 1/2\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/framing/joist_spacing",
          "is": "16\""
        }
      ]
    },
    {
      "step": "(Open Floor 1's floor dialog: Joist Spacing 16\", Rim Joists LVL)",
      "commands": [
        {
          "op": "update",
          "id": "$named:floor:Floor 1",
          "set": {
            "joist_spacing": "16\"",
            "rim_material": "lvl"
          }
        }
      ],
      "expect": [
        {
          "get": "$named:floor:Floor 1",
          "path": "/rim_material",
          "is": "lvl"
        }
      ]
    },
    {
      "step": "Framing Reference Marker at the outside corner of the framing, bottom left",
      "commands": [
        {
          "op": "update",
          "id": "$named:floor:Floor 1",
          "set": {
            "framing_origin": [
              0.0,
              -11887.2
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$named:floor:Floor 1",
          "path": "/framing_origin/0",
          "is": "0\""
        }
      ]
    },
    {
      "step": "Copy the Framing, Floor layer set as 'Framing Set - Working' and turn on ceiling joists",
      "commands": [
        {
          "op": "add_layer_set",
          "name": "Framing Set - Working"
        }
      ],
      "expect": [
        {
          "get": "$named:layer_set:Framing Set - Working",
          "path": "/name",
          "is": "Framing Set - Working"
        }
      ]
    },
    {
      "step": "Build Framing: floors and ceilings, rebuilt automatically",
      "commands": [
        {
          "op": "build_framing",
          "floor": null,
          "parts": {
            "walls": false,
            "floors": true,
            "ceilings": true,
            "roofs": false
          }
        }
      ],
      "expect": [
        {
          "joists": "floor_joist",
          "floor": "$floor1",
          "run": "y"
        }
      ]
    },
    {
      "step": "(Automatically Rebuild Framing)",
      "gap": "Framing rebuilds when you choose Build Framing, not automatically when the model changes. Row: FR-35"
    },
    {
      "step": "Joist Direction: a horizontal line in the basement; the joists turn to follow it",
      "commands": [
        {
          "op": "add_joist_direction",
          "floor": "$floor1",
          "at": [
            2540.0,
            -2540.0
          ],
          "angle": 0.0
        }
      ],
      "save": {
        "jd": "joist_direction"
      }
    },
    {
      "step": "(rebuild)",
      "commands": [
        {
          "op": "build_framing",
          "floor": "$floor1",
          "parts": {
            "walls": false,
            "floors": true,
            "ceilings": true,
            "roofs": false
          }
        }
      ],
      "expect": [
        {
          "joists": "floor_joist",
          "floor": "$floor1",
          "run": "x"
        }
      ]
    },
    {
      "step": "Rotate the line 90 degrees: the joists follow",
      "commands": [
        {
          "op": "update",
          "id": "$jd",
          "set": {
            "angle": 90.0
          }
        },
        {
          "op": "build_framing",
          "floor": "$floor1",
          "parts": {
            "walls": false,
            "floors": true,
            "ceilings": true,
            "roofs": false
          }
        }
      ],
      "expect": [
        {
          "joists": "floor_joist",
          "floor": "$floor1",
          "run": "y"
        }
      ]
    },
    {
      "step": "Delete it (joists go back), Undo; turn off automatic rebuild and delete it again",
      "commands": [
        {
          "op": "delete",
          "ids": [
            "$jd"
          ]
        },
        {
          "op": "build_framing",
          "floor": "$floor1",
          "parts": {
            "walls": false,
            "floors": true,
            "ceilings": true,
            "roofs": false
          }
        }
      ],
      "expect": [
        {
          "joists": "floor_joist",
          "floor": "$floor1",
          "run": "y"
        }
      ]
    },
    {
      "step": "Bearing wall: the basement wall left of the stair becomes a foundation wall and a bearing wall",
      "commands": [
        {
          "op": "update",
          "id": "$stairwall",
          "set": {
            "shape": {
              "bearing": true
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$stairwall",
          "path": "/shape/bearing",
          "is": true
        }
      ]
    },
    {
      "step": "Build Framing once, Floors, Floor 1 only: the joists turn to bear on it",
      "commands": [
        {
          "op": "build_framing",
          "floor": "$floor1",
          "parts": {
            "walls": false,
            "floors": true,
            "ceilings": true,
            "roofs": false
          }
        }
      ]
    },
    {
      "step": "(Joists choose the shorter span between bearing walls and beams)",
      "expect": [
        {
          "joists": "floor_joist",
          "floor": "$floor1"
        }
      ]
    },
    {
      "step": "Post and beam defaults: beams 12\" x 3 1/2\"; 3 1/2\" posts with square footings",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "framing": {
              "beam_depth": "12\"",
              "beam_width": "3 1/2\"",
              "post_size": "3 1/2\"",
              "post_footing": "16\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/framing/post_size",
          "is": "3 1/2\""
        }
      ]
    },
    {
      "step": "Post with Footing at the top of the stair wall; another at the top left of the Garage",
      "commands": [
        {
          "op": "add_framing_member",
          "floor": "$named:floor:Foundation",
          "role": "post",
          "a": [
            4146.55,
            -4959.35,
            -2873.375
          ],
          "b": [
            4146.55,
            -4959.35,
            -323.85
          ]
        },
        {
          "op": "add_framing_member",
          "floor": "$named:floor:Foundation",
          "role": "post",
          "a": [
            8737.6,
            -8534.4,
            -2873.375
          ],
          "b": [
            8737.6,
            -8534.4,
            -625.475
          ]
        }
      ],
      "save": {
        "posts": "framing_member"
      },
      "expect": [
        {
          "get": "$posts.0",
          "path": "/role",
          "is": "footing"
        },
        {
          "get": "$posts.1",
          "path": "/role",
          "is": "post"
        },
        {
          "get": "$posts.1",
          "path": "/width",
          "is": "3 1/2\""
        }
      ]
    },
    {
      "step": "Floor/Ceiling Beam from the post to the back wall, its top level with the joists",
      "commands": [
        {
          "op": "add_framing_member",
          "floor": "$named:floor:Foundation",
          "role": "beam",
          "a": [
            4146.55,
            -4959.35,
            -171.45
          ],
          "b": [
            4146.55,
            -254.0,
            -171.45
          ],
          "width": "3 1/2\"",
          "depth": "12\""
        }
      ],
      "save": {
        "beam": "framing_member"
      },
      "expect": [
        {
          "get": "$beam",
          "path": "/depth",
          "is": "12\""
        }
      ]
    },
    {
      "step": "A second beam from the Garage post to the back wall, lowered 11 7/8\" so the joists sit on it",
      "commands": [
        {
          "op": "add_framing_member",
          "floor": "$named:floor:Foundation",
          "role": "beam",
          "a": [
            8737.6,
            -8534.4,
            -473.075
          ],
          "b": [
            8737.6,
            -254.0,
            -473.075
          ],
          "width": "3 1/2\"",
          "depth": "12\""
        }
      ],
      "save": {
        "beam2": "framing_member"
      },
      "expect": [
        {
          "get": "$beam2",
          "path": "/role",
          "is": "beam"
        }
      ]
    },
    {
      "step": "Rebuild: joists butt the first beam and lap over the second",
      "commands": [
        {
          "op": "build_framing",
          "floor": "$floor1",
          "parts": {
            "walls": false,
            "floors": true,
            "ceilings": false,
            "roofs": false
          }
        }
      ],
      "expect": [
        {
          "joist_ends_at_x": 4146.55,
          "floor": "$floor1",
          "within": 60.0,
          "at_least": 6
        }
      ]
    },
    {
      "step": "Move a ceiling joist; joists bump and push (Bumping/Pushing snap)",
      "gap": "Joists can be moved but don't bump or push. Row: CAD-28"
    },
    {
      "step": "Trim the ceiling joists to a selected joist: select a joist, Shift+click the joist to trim to, Edit > Trim / Extend to Second Object (covered by the framing_members_trim_extend_and_break test). No Sticky Mode, so do one joist at a time"
    },
    {
      "step": "Framing rich text defaults: uppercase, centred, border with 6\" margins",
      "commands": [
        {
          "op": "add_text_style",
          "name": "Framing Notes",
          "height": "6\""
        }
      ],
      "save": {
        "fcaps": "text_style"
      }
    },
    {
      "step": "(capitals)",
      "commands": [
        {
          "op": "update",
          "id": "$fcaps",
          "set": {
            "uppercase": true
          }
        }
      ],
      "expect": [
        {
          "get": "$fcaps",
          "path": "/uppercase",
          "is": true
        }
      ]
    },
    {
      "step": "Rich Text on Floor 0: ALL FLOOR JOISTS ARE U.N.O.: 2x12s SPF #2 OR BETTER @16\" O.C.",
      "commands": [
        {
          "op": "add_text",
          "floor": "$named:floor:Foundation",
          "position": [
            1524.0,
            -10668.0
          ],
          "text": "ALL FLOOR JOISTS ARE U.N.O.:\n2x12s SPF #2 OR BETTER @16\" O.C.",
          "justify": "center"
        }
      ],
      "save": {
        "note": "text"
      },
      "expect": [
        {
          "text_exists": "ALL FLOOR JOISTS ARE U.N.O.:\n2x12s SPF #2 OR BETTER @16\" O.C."
        }
      ]
    },
    {
      "step": "(border with 6\" margins)",
      "commands": [
        {
          "op": "update",
          "id": "$note",
          "set": {
            "border": true,
            "border_margin": "6\"",
            "style": "$fcaps"
          }
        }
      ],
      "expect": [
        {
          "get": "$note",
          "path": "/border_margin",
          "is": "6\""
        }
      ]
    },
    {
      "step": "Copy it beside the deck joists and change it to deck joists, 2x10s",
      "commands": [
        {
          "op": "add_text",
          "floor": "$named:floor:Foundation",
          "position": [
            6350.0,
            1524.0
          ],
          "text": "ALL DECK JOISTS ARE U.N.O.:\n2x10s SPF #2 OR BETTER @16\" O.C.",
          "justify": "center"
        }
      ],
      "expect": [
        {
          "text_exists": "ALL DECK JOISTS ARE U.N.O.:\n2x10s SPF #2 OR BETTER @16\" O.C."
        }
      ]
    },
    {
      "step": "Make a Copy as Chic Cottage-Floor Framing"
    }
  ]
}
