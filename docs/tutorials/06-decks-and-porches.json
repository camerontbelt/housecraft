{
  "tutorial": "Decks and Porches",
  "source": "Chief Architect X18 Tutorial Guide, Floor Plan Tutorials, pages 105-126",
  "include": "05-doors-and-windows.json",
  "steps": [
    {
      "step": "Pin CHIC COTTAGE-CURRENT in the Dashboard's recent documents",
      "gap": "No Dashboard; pin the plan in File > Recent Files instead. Row: UI-30"
    },
    {
      "step": "Deck Railing, Railing and Half Wall defaults (5 1/2\" capped posts, 1 1/4\" square balusters 5\" OC, white; half wall Siding-6 over Stone-6 at 20\", 16\" upper)",
      "gap": "No separate Deck Railing / Railing / Half Wall defaults or a Half Wall tool; draw walls and set each one's height (and pony) in its specification. Row: WL-29"
    },
    {
      "step": "Porch: two half walls enclosing the area outside the front door, the front one 8' from the entry wall, the left one in line with the Dining/Foyer wall",
      "commands": [
        {
          "op": "add_walls",
          "floor": "$floor1",
          "height": "36\"",
          "points": [
            [
              4146.55,
              -8473.281
            ],
            [
              4146.55,
              -10911.681
            ],
            [
              8798.719,
              -10911.681
            ]
          ]
        }
      ],
      "save": {
        "half": "wall"
      },
      "expect": [
        {
          "get": "$half.1",
          "path": "/height",
          "is": "36\""
        }
      ]
    },
    {
      "step": "Make the new room a Porch",
      "commands": [
        {
          "op": "update",
          "id": "$room_at:6350.0,-9652.0",
          "set": {
            "room_type": "$named:room_type:Porch"
          }
        }
      ],
      "expect": [
        {
          "get": "$room_at:6350.0,-9652.0",
          "path": "/room_type",
          "is": "$named:room_type:Porch"
        },
        {
          "missing": "$wall_at:6350.0,-10810.1@Foundation"
        },
        {
          "get": "$wall_at:3810.0,-8473.3@Foundation",
          "path": "/wall_type",
          "is": "$named:8\" Concrete with Furring"
        }
      ]
    },
    {
      "step": "(The basement doesn't extend under the porch)",
      "expect": [
        {
          "missing": "$wall_at:4044.9,-9652.0@Foundation"
        }
      ]
    },
    {
      "step": "Deck defaults: 1\" planks with 1/4\" gaps; deck post footings 30\" deep",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "deck": {
              "plank_thickness": "1\"",
              "plank_gap": "1/4\"",
              "footing_depth": "30\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/deck/footing_depth",
          "is": "30\""
        }
      ]
    },
    {
      "step": "Deck at the back: three deck railings enclosing a deck room, 36\" in from each side wall and 8' deep",
      "commands": [
        {
          "op": "add_deck",
          "floor": "$floor1",
          "points": [
            [
              914.4,
              30.162
            ],
            [
              11887.2,
              30.162
            ],
            [
              11887.2,
              2468.562
            ],
            [
              914.4,
              2468.562
            ]
          ]
        }
      ],
      "save": {
        "deck": "deck"
      },
      "expect": [
        {
          "count": "deck",
          "is": 1
        },
        {
          "get": "$deck",
          "path": "/railing",
          "is": true
        }
      ]
    },
    {
      "step": "(Plank thickness 1\", gap 1/4\", footings 30\" deep)",
      "commands": [
        {
          "op": "update",
          "id": "$deck",
          "set": {
            "plank_thickness": "1\"",
            "plank_gap": "1/4\"",
            "footing_depth": "30\""
          }
        }
      ],
      "expect": [
        {
          "get": "$deck",
          "path": "/plank_gap",
          "is": "1/4\""
        },
        {
          "get": "$deck",
          "path": "/footing_depth",
          "is": "30\""
        }
      ]
    },
    {
      "step": "(In Chief the deck is a room drawn with Deck Railings: with the Deck tool, double-click inside railings to fill them; here the deck draws its own railing)",
      "expect": [
        {
          "get": "$deck",
          "path": "/footing_depth",
          "is": "30\""
        }
      ]
    },
    {
      "step": "Move the three automatic dimensions out of the deck (Transform/Replicate, 8' up); they stop refreshing",
      "gap": "Automatic dimensions can't be moved or edited without being rebuilt. Row: DIM-27"
    },
    {
      "step": "A dimension along the deck's outer edge, then add and remove extension lines",
      "commands": [
        {
          "op": "add_dimension",
          "floor": "$floor1",
          "geometry": {
            "type": "linear",
            "points": [
              [
                914.4,
                2468.562
              ],
              [
                11887.2,
                2468.562
              ]
            ],
            "orientation": "horizontal",
            "offset": "2'"
          }
        }
      ],
      "save": {
        "deckdim": "dimension"
      },
      "expect": []
    },
    {
      "step": "(Select it, Edit > Add Extension Line and click the middle of the edge; Edit > Remove Extension Line and click it again)",
      "commands": [
        {
          "op": "add_dimension_point",
          "id": "$deckdim",
          "at": [
            6400.8,
            2468.562
          ]
        },
        {
          "op": "remove_dimension_point",
          "id": "$deckdim",
          "index": 1
        }
      ],
      "expect": [
        {
          "get": "$deckdim",
          "path": "/geometry/points/1/0",
          "is": 11887.2
        }
      ]
    },
    {
      "step": "(Add Segment: one more extension line past the end, to the house's right side)",
      "commands": [
        {
          "op": "add_dimension_point",
          "id": "$deckdim",
          "at": [
            12801.6,
            2468.562
          ]
        }
      ],
      "expect": [
        {
          "get": "$deckdim",
          "path": "/geometry/points/2/0",
          "is": 12801.6
        }
      ]
    },
    {
      "step": "Terrain perimeter, 60' deep, centred on the house's right side; surface 28\" below the subfloor at the Garage's front corner",
      "commands": [
        {
          "op": "add_terrain",
          "floor": "$floor1",
          "points": [
            [
              -6096.0,
              6096.0
            ],
            [
              18897.6,
              6096.0
            ],
            [
              18897.6,
              -12192.0
            ],
            [
              -6096.0,
              -12192.0
            ]
          ]
        }
      ],
      "save": {
        "terrain": "terrain"
      },
      "expect": [
        {
          "count": "terrain",
          "is": 1
        }
      ]
    },
    {
      "step": "(Surface at the reference point: -28\")",
      "commands": [
        {
          "op": "update",
          "id": "$terrain",
          "set": {
            "base_elevation": "-28\""
          }
        }
      ],
      "expect": [
        {
          "get": "$terrain",
          "path": "/base_elevation",
          "is": "-28\""
        }
      ]
    },
    {
      "step": "(Terrain reference point at the Garage's front corner: open the terrain, tick Reference Point and set Reference At)",
      "commands": [
        {
          "op": "update",
          "id": "$terrain",
          "set": {
            "reference": [
              12801.6,
              -11684.0
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$terrain",
          "path": "/base_elevation",
          "is": "-28\""
        }
      ]
    },
    {
      "step": "Turn on the Footings, Deck Post layer",
      "commands": [
        {
          "op": "set_layer_display",
          "layer_set": "$named:layer_set:Working",
          "layer": "$named:layer:Footings, Deck Post",
          "visible": true
        }
      ],
      "expect": [
        {
          "get": "$named:layer:Footings, Deck Post",
          "path": "/name",
          "is": "Footings, Deck Post"
        }
      ]
    },
    {
      "step": "Porch stem walls on Floor 0 under the porch walls, 37 1/2\" high, no floor under the porch room",
      "gap": "No Straight Foundation Wall tool or room stem-wall height; draw walls on the Foundation floor and set their height. Row: FD-09"
    },
    {
      "step": "Exterior stair defaults (capped newels 5 1/2\", white rails, redwood treads, treated stringers)",
      "commands": [
        {
          "op": "add_material",
          "name": "Redwood",
          "color": "#8a3b2a"
        },
        {
          "op": "add_material",
          "name": "Treated Lumber",
          "color": "#7c8a5a"
        }
      ],
      "save": {
        "woods": "material"
      }
    },
    {
      "step": "(the exterior stair defaults)",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "exterior_stair": {
              "newel_style": "capped",
              "newel_size": "5 1/2\"",
              "materials": {
                "stair": "$woods.0",
                "stringer": "$woods.1",
                "railing": "$named:material:White Rail Paint"
              }
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/exterior_stair/newel_style",
          "is": "capped"
        }
      ]
    },
    {
      "step": "Deck stairs: outside the left deck railing, going down to the terrain (Open Object > Down to grade); 5' wide with railings both sides. The deck railing opens where they meet it",
      "commands": [
        {
          "op": "add_stair",
          "floor": "$floor1",
          "start": [
            914.4,
            1249.4
          ],
          "direction": 0,
          "width": "5'",
          "railing_left": true,
          "railing_right": true
        }
      ],
      "save": {
        "deck_stairs": "stair"
      }
    },
    {
      "step": "(Open the stair: tick Down to grade)",
      "commands": [
        {
          "op": "update",
          "id": "$deck_stairs",
          "set": {
            "extras": {
              "to_grade": true
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$deck_stairs",
          "path": "/extras/to_grade",
          "is": true
        },
        {
          "stair_to_grade": "$deck_stairs"
        }
      ]
    },
    {
      "step": "Concrete porch stairs, 6' wide, centred on the porch's front, down to grade with no stringers (solid)",
      "commands": [
        {
          "op": "add_stair",
          "floor": "$floor1",
          "start": [
            6472.6,
            -10911.7
          ],
          "direction": 90,
          "width": "6'",
          "railing_left": true,
          "railing_right": true
        }
      ],
      "save": {
        "porch_stairs": "stair"
      }
    },
    {
      "step": "(Open the stair: tick Down to grade, untick Stringers)",
      "commands": [
        {
          "op": "update",
          "id": "$porch_stairs",
          "set": {
            "extras": {
              "to_grade": true
            },
            "stringers": false
          }
        }
      ],
      "expect": [
        {
          "get": "$porch_stairs",
          "path": "/extras/to_grade",
          "is": true
        },
        {
          "stair_to_grade": "$porch_stairs"
        }
      ]
    },
    {
      "step": "Concrete material on the porch stairs (Material Painter, treads)",
      "commands": [
        {
          "op": "paint_material",
          "material": "$named:material:Concrete",
          "ids": [
            "$porch_stairs"
          ],
          "surface": "stair"
        }
      ],
      "expect": []
    },
    {
      "step": "The stairs open the porch's front half wall (Open Walls at Top)",
      "commands": [
        {
          "op": "open_walls_at_stair",
          "stair": "$porch_stairs"
        }
      ]
    },
    {
      "step": "Notes: 'CONCRETE STEPS TO GRADE', 'FRAMED STEPS TO GRADE', and numbered note 'EXTERIOR LANDING 36\" MINIMUM IN DIRECTION OF TRAVEL' (copied to both stairs)",
      "commands": [
        {
          "op": "add_text",
          "floor": "$floor1",
          "position": [
            6096.0,
            -12435.681
          ],
          "text": "CONCRETE STEPS TO GRADE"
        },
        {
          "op": "add_text",
          "floor": "$floor1",
          "position": [
            -762.0,
            1524.0
          ],
          "text": "FRAMED STEPS TO GRADE"
        },
        {
          "op": "add_callout",
          "floor": "$floor1",
          "text": "EXTERIOR LANDING 36\" MINIMUM IN DIRECTION OF TRAVEL",
          "at": [
            -508.0,
            1016.0
          ],
          "marker": "circle"
        }
      ],
      "save": {
        "landing": "callout"
      },
      "expect": [
        {
          "text_exists": "CONCRETE STEPS TO GRADE"
        }
      ]
    },
    {
      "step": "(Numbered note and its copy)",
      "commands": [
        {
          "op": "update",
          "id": "$landing",
          "set": {
            "note": true
          }
        },
        {
          "op": "transform",
          "ids": [
            "$landing"
          ],
          "transform": {
            "type": "translate",
            "dx": "260\"",
            "dy": "-560\""
          },
          "copies": 1
        }
      ],
      "expect": [
        {
          "get": "$landing",
          "path": "/note",
          "is": true
        }
      ]
    },
    {
      "step": "Note Schedule beside the plan",
      "commands": [
        {
          "op": "add_schedule",
          "floor": "$floor1",
          "schedule_kind": "notes",
          "position": [
            15240.0,
            0.0
          ]
        }
      ],
      "save": {
        "notes": "schedule"
      },
      "expect": [
        {
          "get": "$notes",
          "path": "/schedule_kind",
          "is": "notes"
        }
      ]
    },
    {
      "step": "Reorder the Note Schedule: open it and use the ▲ / ▼ (Move Up / Move Down in Schedule) buttons under Row Order",
      "commands": [
        {
          "op": "update",
          "id": "$notes",
          "set": {
            "order": [
              "$landing"
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$notes",
          "path": "/order/0",
          "is": "$landing"
        }
      ]
    },
    {
      "step": "Save a copy; organise the archive plans in a Project Browser folder"
    }
  ]
}
