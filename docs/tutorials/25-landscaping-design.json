{
  "tutorial": "Landscaping Design",
  "source": "Chief Architect X18 Tutorial Guide, Landscaping Tutorials, pages 433-450",
  "include": "24-driveways-sidewalks-roads.json",
  "steps": [
    {
      "step": "Landscaping layer set: lock the road and sidewalk layers, hide elevation data",
      "expect": [
        {
          "get": "$named:layer_set:Landscaping Layer Set",
          "path": "/name",
          "is": "Landscaping Layer Set"
        }
      ]
    },
    {
      "step": "Material default for Dirt: Mulch - Dark",
      "commands": [
        {
          "op": "add_material",
          "name": "Mulch - Dark",
          "color": "#3a2a1e"
        }
      ],
      "save": {
        "mulch": "material"
      }
    },
    {
      "step": "(set it as the Dirt default)",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "materials": {
              "dirt": "$mulch"
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/materials/dirt",
          "is": "$mulch"
        }
      ]
    },
    {
      "step": "Polyline Garden Bed between the porch stairs, the Garage, the sidewalk and the driveway",
      "commands": [
        {
          "op": "add_site_feature",
          "floor": "$floor1",
          "points": [
            [
              6400.8,
              -11582.4
            ],
            [
              8686.8,
              -11734.8
            ],
            [
              8991.6,
              -14935.2
            ],
            [
              6400.8,
              -14935.2
            ]
          ],
          "feature": {
            "type": "garden_bed",
            "height": "0\""
          }
        }
      ],
      "save": {
        "bed": "site_feature"
      },
      "expect": [
        {
          "get": "$bed",
          "path": "/feature/type",
          "is": "garden_bed"
        }
      ]
    },
    {
      "step": "Add Break on the bed's sidewalk edge, then Move Edge to pull the left half 1' toward the sidewalk",
      "commands": [
        {
          "op": "break_wall",
          "id": "$bed",
          "at": [
            7620.0,
            -14935.2
          ]
        },
        {
          "op": "move_edge",
          "id": "$bed",
          "edge": 3,
          "to": [
            7000.0,
            -15240.0
          ]
        }
      ],
      "expect": [
        {
          "get": "$bed",
          "path": "/points/3/1",
          "is": "-50'"
        },
        {
          "get": "$bed",
          "path": "/points/4/1",
          "is": "-50'"
        },
        {
          "get": "$bed",
          "path": "/points/2/1",
          "is": -14935.2
        }
      ]
    },
    {
      "step": "Change Line/Arc: curve the bed's edge along the sidewalk (6' radius)",
      "commands": [
        {
          "op": "curve_edge",
          "id": "$bed",
          "edge": 3,
          "radius": "6'"
        }
      ],
      "expect": [
        {
          "get": "$bed",
          "path": "/points",
          "len_at_least": 7
        }
      ]
    },
    {
      "step": "Planting border: copy the plot plan polyline in place, Convert Polyline > Garden Bed",
      "commands": [
        {
          "op": "add_cad",
          "floor": "$floor1",
          "shape": {
            "shape": "polyline",
            "points": [
              [
                -16764.0,
                12192.0
              ],
              [
                22860.0,
                34137.6
              ],
              [
                24384.0,
                30480.0
              ],
              [
                -14630.4,
                9144.0
              ]
            ],
            "closed": true
          }
        }
      ],
      "save": {
        "border_line": "cad"
      }
    },
    {
      "step": "(convert)",
      "commands": [
        {
          "op": "convert_cad",
          "ids": [
            "$border_line"
          ],
          "to": {
            "type": "site_feature",
            "feature": {
              "type": "garden_bed",
              "height": "0\""
            }
          }
        }
      ],
      "save": {
        "border": "site_feature"
      },
      "expect": [
        {
          "count": "site_feature",
          "is": 8
        }
      ]
    },
    {
      "step": "Align the border's inside edge with its outside edge: lock its start and set the angle (one edge, not the whole bed)",
      "commands": [
        {
          "op": "set_edge_angle",
          "id": "$border",
          "edge": 2,
          "angle": 208.9797077
        }
      ],
      "expect": [
        {
          "get": "$border",
          "path": "/points/2/0",
          "is": "80'"
        },
        {
          "get": "$border",
          "path": "/points/3/0",
          "is": -14515.684
        }
      ]
    },
    {
      "step": "Fencing defaults: 72\" post spacing, 5 1/2\" posts 74\" high, iron pole panels, rails 5 1/2\"",
      "commands": [
        {
          "op": "update",
          "id": "$named:default_set:Default",
          "set": {
            "fence": {
              "style": "iron_pole",
              "height": "74\"",
              "post_spacing": "72\"",
              "post_size": "5 1/2\"",
              "rail_size": "5 1/2\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$named:default_set:Default",
          "path": "/fence/style",
          "is": "iron_pole"
        }
      ]
    },
    {
      "step": "Straight Fencing along the left setback, the back and the right angled setback",
      "commands": [
        {
          "op": "add_site_feature",
          "floor": "$floor1",
          "points": [
            [
              -7620.0,
              -13716.0
            ],
            [
              -13716.0,
              9753.6
            ],
            [
              21336.0,
              31394.4
            ],
            [
              35966.4,
              3657.6
            ]
          ],
          "feature": {
            "type": "fence",
            "style": "privacy",
            "height": "6'",
            "post_spacing": "72\"",
            "post_size": "5 1/2\"",
            "rail_size": "5 1/2\""
          }
        }
      ],
      "save": {
        "fence": "site_feature"
      },
      "expect": [
        {
          "get": "$fence",
          "path": "/feature/height",
          "is": "6'"
        },
        {
          "get": "$fence",
          "path": "/feature/post_size",
          "is": "5 1/2\""
        }
      ]
    },
    {
      "step": "(The fence replaces the retaining wall where they overlap; Undo; move the wall) — Not needed: fences and retaining walls are separate objects that can overlap."
    },
    {
      "step": "A gate in the back fence near the left corner, 72\" high, 4\" off the ground",
      "commands": [
        {
          "op": "update",
          "id": "$fence",
          "set": {
            "feature": {
              "type": "fence",
              "style": "privacy",
              "height": "6'",
              "post_spacing": "72\"",
              "gates": [
                {
                  "at": "86'",
                  "width": "4'",
                  "height": "72\"",
                  "style": "picket",
                  "clearance": "4\""
                }
              ],
              "post_size": "5 1/2\"",
              "rail_size": "5 1/2\""
            }
          }
        }
      ],
      "expect": [
        {
          "get": "$fence",
          "path": "/feature/gates/0/width",
          "is": "4'"
        },
        {
          "get": "$fence",
          "path": "/feature/gates/0/height",
          "is": "72\""
        },
        {
          "get": "$fence",
          "path": "/feature/gates/0/clearance",
          "is": "4\""
        }
      ]
    },
    {
      "step": "(Open the fence: under Gates set the gate's style, tall 72\" and off ground 4\")"
    },
    {
      "step": "Plant Chooser: search 'fir', place a Balsam Fir at the top right corner of the lot",
      "commands": [
        {
          "op": "add_plant",
          "floor": "$floor1",
          "at": [
            30480.0,
            28041.6
          ],
          "name": "Balsam Fir",
          "form": "conifer"
        }
      ],
      "expect": [
        {
          "count": "plant",
          "is": 1
        }
      ]
    },
    {
      "step": "(Plant Chooser search and plant information)",
      "gap": "No plant chooser or plant encyclopedia. Rows: SITE-20, SITE-21"
    },
    {
      "step": "Two adult paper birches behind the retaining walls",
      "commands": [
        {
          "op": "add_plant",
          "floor": "$floor1",
          "at": [
            34137.6,
            15849.6
          ],
          "name": "Paper Birch",
          "form": "tree",
          "height": "40'",
          "spread": "25'"
        },
        {
          "op": "add_plant",
          "floor": "$floor1",
          "at": [
            31699.2,
            18897.6
          ],
          "name": "Paper Birch",
          "form": "tree",
          "height": "40'",
          "spread": "25'"
        }
      ],
      "save": {
        "birch": "plant"
      },
      "expect": [
        {
          "get": "$birch.0",
          "path": "/height",
          "is": "40'"
        }
      ]
    },
    {
      "step": "Reverse one birch's image and resize it",
      "commands": [
        {
          "op": "update",
          "id": "$birch.1",
          "set": {
            "height": "34'"
          }
        }
      ],
      "expect": [
        {
          "get": "$birch.1",
          "path": "/height",
          "is": "34'"
        }
      ]
    },
    {
      "step": "(Reverse Image: plants here are 3D shapes rather than pictures, so there's nothing to flip)"
    },
    {
      "step": "Three rhododendrons blocked together and copied along the angled retaining wall",
      "commands": [
        {
          "op": "add_plant",
          "floor": "$floor1",
          "at": [
            18288.0,
            21336.0
          ],
          "name": "Rhododendron (cream)",
          "form": "shrub"
        },
        {
          "op": "add_plant",
          "floor": "$floor1",
          "at": [
            19202.4,
            21640.8
          ],
          "name": "Rhododendron (cream)",
          "form": "shrub"
        },
        {
          "op": "add_plant",
          "floor": "$floor1",
          "at": [
            18592.8,
            22250.4
          ],
          "name": "Rhododendron (cream)",
          "form": "shrub"
        }
      ],
      "save": {
        "rh": "plant"
      },
      "expect": [
        {
          "count": "plant",
          "is": 6
        }
      ]
    },
    {
      "step": "(copies)",
      "commands": [
        {
          "op": "transform",
          "ids": [
            "$rh.0",
            "$rh.1",
            "$rh.2"
          ],
          "transform": {
            "type": "translate",
            "dx": "12'",
            "dy": "-8'"
          },
          "copies": 2
        }
      ],
      "expect": [
        {
          "count": "plant",
          "is": 12
        }
      ]
    },
    {
      "step": "(Select the three rhododendrons, Edit > Make Architectural Block, so they move and copy as one)",
      "commands": [
        {
          "op": "make_group",
          "ids": [
            "$rh.0",
            "$rh.1",
            "$rh.2"
          ],
          "name": "Rhododendrons"
        }
      ],
      "save": {
        "rhblock": "group"
      },
      "expect": [
        {
          "get": "$rhblock",
          "path": "/name",
          "is": "Rhododendrons"
        }
      ]
    },
    {
      "step": "Plant schedule",
      "commands": [
        {
          "op": "add_schedule",
          "floor": "$floor1",
          "schedule_kind": "plants",
          "position": [
            -24384.0,
            18288.0
          ]
        }
      ],
      "save": {
        "psched": "schedule"
      },
      "expect": [
        {
          "get": "$psched",
          "path": "/schedule_kind",
          "is": "plants"
        }
      ]
    },
    {
      "step": "Make a Copy as Chic Cottage-Landscaping; a Landscaping Tutorials folder"
    }
  ]
}
