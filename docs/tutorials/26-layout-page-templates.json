{
  "tutorial": "Layout Page Templates",
  "source": "Chief Architect X18 Tutorial Guide, Layout Tutorials, pages 451-459",
  "include": "25-landscaping-design.json",
  "steps": [
    {
      "step": "Open (or start) the Chic Cottage layout",
      "commands": [
        {
          "op": "add_layout",
          "name": "Chic Cottage",
          "pages": 2
        }
      ],
      "save": {
        "lay": "layout"
      },
      "expect": [
        {
          "get": "$lay",
          "path": "/pages/1",
          "is": "A-2"
        }
      ]
    },
    {
      "step": "(A separate .layout file)",
      "gap": "Layouts live in the plan file, not a separate layout file. Row: PRJ-46"
    },
    {
      "step": "Page 0 'Standard Template' and page 1 'Cover Sheet Template' as page templates",
      "commands": [
        {
          "op": "update",
          "id": "$lay",
          "set": {
            "pages": [
              "Template",
              "Cover Template"
            ],
            "titles": [
              "Standard Template",
              "Cover Sheet Template"
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$lay",
          "path": "/titles/0",
          "is": "Standard Template"
        }
      ]
    },
    {
      "step": "Use as Page Template: the two template pages don't print",
      "commands": [
        {
          "op": "update",
          "id": "$lay",
          "set": {
            "template_pages": [
              0,
              1
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$lay",
          "path": "/template_pages/1",
          "is": 1
        }
      ]
    },
    {
      "step": "Pages 2-6: page 2 uses the Cover Sheet Template, pages 3-6 the Standard Template; titles Cover Sheet, General Notes, Site Plan",
      "commands": [
        {
          "op": "add_layout_page",
          "layout": "$lay"
        },
        {
          "op": "add_layout_page",
          "layout": "$lay"
        },
        {
          "op": "add_layout_page",
          "layout": "$lay"
        },
        {
          "op": "add_layout_page",
          "layout": "$lay"
        },
        {
          "op": "add_layout_page",
          "layout": "$lay"
        }
      ],
      "expect": [
        {
          "get": "$lay",
          "path": "/pages/6",
          "is": "A-7"
        }
      ]
    },
    {
      "step": "(templates and titles)",
      "commands": [
        {
          "op": "update",
          "id": "$lay",
          "set": {
            "titles": [
              "Standard Template",
              "Cover Sheet Template",
              "Cover Sheet",
              "General Notes",
              "Site Plan",
              "Floor 1 Plan",
              "Electrical Floor 1"
            ],
            "templates": [
              null,
              null,
              1,
              0,
              0,
              0,
              0
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$lay",
          "path": "/templates/2",
          "is": 1
        },
        {
          "get": "$lay",
          "path": "/templates/6",
          "is": 0
        },
        {
          "get": "$lay",
          "path": "/titles/4",
          "is": "Site Plan"
        }
      ]
    },
    {
      "step": "Page labels A0.#, A1.#, A1.#, E1.#: each prefix numbered on its own",
      "commands": [
        {
          "op": "update",
          "id": "$lay",
          "set": {
            "pages": [
              "Template",
              "Cover Template",
              "Cover",
              "A0.1",
              "A1.1",
              "A1.2",
              "E1.1"
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$lay",
          "path": "/pages/5",
          "is": "A1.2"
        }
      ]
    },
    {
      "step": "# in a label numbers the page within its prefix",
      "commands": [
        {
          "op": "label_pages",
          "layout": "$lay",
          "labels": [
            "Template",
            "Cover Template",
            "Cover",
            "A0.#",
            "A1.#",
            "A1.#",
            "E1.#"
          ]
        }
      ],
      "expect": [
        {
          "get": "$lay",
          "path": "/pages/5",
          "is": "A1.2"
        },
        {
          "get": "$lay",
          "path": "/pages/6",
          "is": "E1.1"
        }
      ]
    },
    {
      "step": "Insert Page Before page 5 (Foundation Plan, A1.#); Insert Page After page 6 (Elevations, A2.#) and after 7 (Sections, A2.#)",
      "commands": [
        {
          "op": "insert_layout_page",
          "layout": "$lay",
          "at": 5,
          "title": "Foundation Plan"
        },
        {
          "op": "insert_layout_page",
          "layout": "$lay",
          "at": 7,
          "title": "Elevations"
        },
        {
          "op": "insert_layout_page",
          "layout": "$lay",
          "at": 8,
          "title": "Sections"
        },
        {
          "op": "label_pages",
          "layout": "$lay",
          "labels": [
            "Template",
            "Cover Template",
            "Cover",
            "A0.#",
            "A1.#",
            "A1.#",
            "A1.#",
            "A2.#",
            "A2.#",
            "E1.#"
          ]
        },
        {
          "op": "update",
          "id": "$lay",
          "set": {
            "templates": [
              null,
              null,
              1,
              0,
              0,
              0,
              0,
              0,
              0,
              0
            ]
          }
        }
      ],
      "expect": [
        {
          "get": "$lay",
          "path": "/titles/5",
          "is": "Foundation Plan"
        },
        {
          "get": "$lay",
          "path": "/pages/9",
          "is": "E1.1"
        },
        {
          "get": "$lay",
          "path": "/pages/6",
          "is": "A1.3"
        },
        {
          "get": "$lay",
          "path": "/titles/8",
          "is": "Sections"
        }
      ]
    },
    {
      "step": "(Insert Page Before / After: buttons beside each page in the layout's dialog)",
      "expect": [
        {
          "get": "$lay",
          "path": "/pages/7",
          "is": "A2.1"
        }
      ]
    },
    {
      "step": "Make a Copy as Chic Cottage-Page Templates"
    }
  ]
}
